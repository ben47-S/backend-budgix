# ============================================
# CONFIGURATION BASE DE DONNEES
# ============================================
# URL de connexion PostgreSQL
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/budgix?schema=public"

# ============================================
# CONFIGURATION SERVEUR
# ============================================
# Port sur lequel le serveur ecoute
PORT=3000

# Environnement d'execution (development, production, test)
NODE_ENV=development

# URL de l'API (utilisee pour Swagger et tests)
# Optionnel, par defaut: http://localhost:3000/api
API_URL="http://localhost:3000/api"

# ============================================
# CONFIGURATION JWT (AUTHENTIFICATION)
# ============================================
# Cle secrete pour signer les tokens JWT
# IMPORTANT: Changez cette valeur en production avec une cle forte et aleatoire
# Vous pouvez generer une cle avec: openssl rand -base64 32
JWT_SECRET="your-secret-key-change-in-production"

# Duree de validite des tokens JWT
# Format: nombre suivi de s (secondes), m (minutes), h (heures), d (jours)
# Exemples: "1h", "24h", "7d", "30d"
JWT_EXPIRES_IN="7d"

# ============================================
# CONFIGURATION CORS (FRONTEND)
# ============================================
# URL du frontend pour autoriser les requetes CORS
# En developpement: http://localhost:5173 (Vite par defaut)
# En production: https://votre-domaine.com
FRONTEND_URL="http://localhost:4000"

# ============================================
# CONFIGURATION OAUTH GOOGLE
# ============================================
# Ces variables sont necessaires pour l'authentification OAuth Google
# Pour obtenir ces valeurs:
# 1. Allez sur https://console.cloud.google.com/
# 2. Creez un nouveau projet ou selectionnez un projet existant
# 3. Activez l'API "Google+ API" et "Google Identity Toolkit API"
# 4. Allez dans "Identifiants" > "Creer des identifiants" > "ID client OAuth"
# 5. Creez un client OAuth de type "Application Web"
# 6. Copiez le Client ID (Web) ci-dessous
#
# IMPORTANT: Le GOOGLE_CLIENT_ID doit etre le Web Client ID
# C'est le meme que EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID cote frontend

# Client ID Google OAuth (Web Client ID)
GOOGLE_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"

# Client Secret Google OAuth (optionnel pour la validation de token ID)
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ============================================
# VARIABLES DE TEST (OPTIONNEL)
# ============================================
# Numero de telephone pour les tests
# Format: +225 suivi de 10 chiffres
TEST_PHONE="+2250123456789"

# ============================================
# PROXY / REVERSE PROXY (RENDER/CLOUDFLARE)
# ============================================
# Nombre de proxies à "trust" pour calculer correctement req.ip via X-Forwarded-For
# Render + Cloudflare: généralement 2
TRUST_PROXY_HOPS=2

# ============================================
# CONFIGURATION EMAIL (SMTP - Nodemailer)
# ============================================
# Utilisé pour l'envoi des codes de vérification (email) et la suppression de compte.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
# true si vous utilisez 465 (TLS implicite), false si vous utilisez 587 (STARTTLS)
EMAIL_SECURE=false
EMAIL_USER="your-email@example.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="Budgix <your-email@example.com>"

# ============================================
# CONFIGURATION SMS (LeTexto)
# ============================================
# Utilisé pour l'envoi des codes OTP par SMS (auth, téléphone, suppression de compte).
LETEXTO_API_TOKEN="your-letexto-api-token"
LETEXTO_SENDER_ID="Budgix"
