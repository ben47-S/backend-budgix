generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @default(cuid())
  username               String?                 @unique
  phone                  String?                 @unique
  email                  String?                 @unique
  password               String?
  isPremium              Boolean                 @default(false)
  role                   UserRole                @default(USER)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  status                 UserStatus              @default(PENDING_CONSENT)
  termsAcceptedAt        DateTime?
  privacyAcceptedAt      DateTime?
  termsVersion           String?
  privacyVersion         String?
  notificationReminderDismissedAt DateTime?
  budgets                Budget[]
  categories             Category[]
  debts                  Debt[]
  discussions            Discussion[]
  emailVerificationCodes EmailVerificationCode[]
  externalSubscriptions  ExternalSubscription[]
  improvementSuggestions ImprovementSuggestion[]
  notifications          Notification[]
  otpCodes               OtpCode[]
  pushTokens             PushToken[]
  reviews                Review?
  subscription           Subscription?
  approvedPayments       SubscriptionPayment[]   @relation("PaymentApprovedBy")
  rejectedPayments       SubscriptionPayment[]   @relation("PaymentRejectedBy")
  subscriptionPayments   SubscriptionPayment[]
  transactions           Transaction[]
}

/// Modèle pour gérer les paiements d'abonnement premium
model SubscriptionPayment {
  id                String           @id @default(cuid())
  userId            String
  plan              SubscriptionPlan
  amount            Decimal
  status            PaymentStatus    @default(PENDING)
  waveTransactionId String?
  senderName        String?
  transferDate      DateTime?
  rejectionReason   String?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  approvedById      String?
  rejectedById      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  isRenewal         Boolean          @default(false)
  approvedBy        User?            @relation("PaymentApprovedBy", fields: [approvedById], references: [id])
  rejectedBy        User?            @relation("PaymentRejectedBy", fields: [rejectedById], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([waveTransactionId])
}

model OtpCode {
  id        String   @id @default(cuid())
  code      String
  phone     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, expiresAt])
  @@index([code, phone])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  code      String
  email     String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, expiresAt])
  @@index([code, email])
}

model Category {
  id                    String                 @id @default(cuid())
  name                  String
  type                  CategoryType
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  userId                String?
  budgets               Budget[]
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalSubscriptions ExternalSubscription[]
  transactions          Transaction[]

  @@unique([userId, name, type])
}

model Transaction {
  id         String   @id @default(cuid())
  amount     Decimal
  date       DateTime @default(now())
  note       String?
  userId     String
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([userId])
  @@index([categoryId])
  @@index([userId, date])
}

model Subscription {
  id        String           @id @default(cuid())
  plan      SubscriptionPlan
  price     Decimal
  startDate DateTime         @default(now())
  endDate   DateTime?
  updatedAt DateTime         @updatedAt
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endDate])
}

model Debt {
  id              String    @id @default(cuid())
  type            DebtType
  contactName     String
  amount          Decimal
  isPaid          Boolean   @default(false)
  notes           String?
  repaymentDate   DateTime?
  reminderSentAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPaid])
  @@index([userId, type])
}

/// Modèle pour gérer les budgets (fonctionnalité premium)
model Budget {
  id          String     @id @default(cuid())
  amount      Decimal
  type        BudgetType @default(CUSTOM)
  periodStart DateTime
  periodEnd   DateTime
  userId      String
  categoryId  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationThresholds BudgetNotificationThreshold[]

  @@index([userId, periodStart, periodEnd])
  @@index([userId, categoryId, periodStart, periodEnd])
  @@index([userId, type])
  @@index([userId, type, periodStart, periodEnd])
}

/// Modèle pour tracker les seuils de notification de budget déjà envoyés
model BudgetNotificationThreshold {
  id          String   @id @default(cuid())
  budgetId    String
  threshold   Int      // 80, 95, ou 100
  notifiedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, threshold])
  @@index([budgetId])
  @@index([budgetId, threshold])
}

/// Modèle pour gérer les tokens de notification push Expo
model PushToken {
  id                    String   @id @default(cuid())
  token                 String   @unique
  platform              String
  deviceId              String?
  userId                String
  enabled               Boolean  @default(true)
  budgetAlerts          Boolean  @default(true)
  reminders             Boolean  @default(true)
  subscriptionReminders Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

/// Modèle pour sauvegarder les notifications envoyées aux utilisateurs
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  data      Json?
  read      Boolean          @default(false)
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([type])
}

/// Modèle pour gérer les abonnements externes (Netflix, Spotify, etc.)
model ExternalSubscription {
  id              String       @id @default(cuid())
  userId          String
  name            String
  amount          Int
  startDate       DateTime
  billingCycle    BillingCycle
  customDays      Int?
  nextBillingDate DateTime
  categoryId      String?
  notes           String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  category        Category?    @relation(fields: [categoryId], references: [id])
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, nextBillingDate])
  @@index([nextBillingDate])
}

/// Modèle pour gérer les discussions de support client
model Discussion {
  id             String           @id @default(cuid())
  userId         String
  status         DiscussionStatus @default(OPEN)
  lastActivityAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([userId])
  @@index([status])
  @@index([lastActivityAt])
  @@index([userId, status])
}

/// Modèle pour gérer les messages dans les discussions
model Message {
  id           String            @id @default(cuid())
  discussionId String
  senderId     String?
  senderType   MessageSenderType
  content      String
  read         Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  discussion   Discussion        @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([discussionId, createdAt])
  @@index([senderId])
}

/// Modèle pour gérer les avis utilisateurs (note + commentaire)
/// Un utilisateur ne peut avoir qu'un seul avis
model Review {
  id        String   @id @default(cuid())
  userId    String   @unique
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@index([createdAt])
}

/// Modèle pour gérer les suggestions d'amélioration
/// Un utilisateur peut avoir plusieurs suggestions
model ImprovementSuggestion {
  id        String   @id @default(cuid())
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Logs centralisés pour audit et dashboard admin
model Log {
  id        String   @id @default(cuid())
  level     LogLevel @default(INFO)
  scope     LogScope @default(USER)
  action    String
  userId    String?
  adminId   String?
  targetId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([adminId])
  @@index([scope])
  @@index([action])
  @@index([createdAt])
}

enum UserStatus {
  PENDING_CONSENT
  ACTIVE
  SUSPENDED
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

enum DebtType {
  OWED_TO_ME
  I_OWE
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum LogScope {
  USER
  BUSINESS
  SECURITY
  ADMIN
  SYSTEM
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_ALERT
  TRANSACTION_REMINDER
  WEEKLY_SUMMARY
  SUBSCRIPTION_RENEWAL_REMINDER
  PAYMENT_PENDING_VERIFICATION
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  PREMIUM_SUBSCRIPTION_EXPIRATION_REMINDER
  DEBT_REMINDER
}

enum PaymentStatus {
  PENDING
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
  CUSTOM
}

enum BudgetType {
  MONTHLY
  CUSTOM
}

enum BudgetStatus {
  DEPASSE
  EN_COURS
  A_VENIR
}

enum MessageSenderType {
  USER
  ADMIN
}

enum UserRole {
  USER
  ADMIN
}

enum DiscussionStatus {
  OPEN
  CLOSED
  ARCHIVED
}
